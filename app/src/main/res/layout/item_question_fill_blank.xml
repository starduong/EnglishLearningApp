<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_question_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Instruction -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Complete the following text:"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Đoạn văn có chỗ trống -->
    <TextView
        android:id="@+id/tvExerciseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="7dp"
        android:textColor="#333333"
        android:textSize="15sp" />

    <!-- Word Bank Label -->
    <TextView
        android:id="@+id/tvWordBankLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Word Bank:"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Word Bank: DÙNG FLEXBOX ĐỂ TỰ ĐỘNG XUỐNG DÒNG -->
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/layoutWordBank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:alignItems="center"
        app:flexWrap="wrap"
        app:justifyContent="flex_start" />

    <!-- Khoảng cách cố định đẹp giữa Word Bank và ô điền -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp" />

    <!-- Các ô Blank 1, Blank 2... -->
    <LinearLayout
        android:id="@+id/layoutInputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Hiển thị đáp án đúng + điểm -->
    <LinearLayout
        android:id="@+id/layoutCorrectAnswers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Nút Check & Again -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckAnswer"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Check Answers"
            android:textSize="14sp"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgain"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Again"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="#757575"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white" />

    </LinearLayout>

</LinearLayout>